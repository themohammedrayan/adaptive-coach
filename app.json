{
  "expo": {
    "name": "adaptive-coach",
    "slug": "adaptive-coach",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adaptivecoach",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.rayan.adaptivecoach",
      "adaptiveIcon": {
        "backgroundColor": "#047857",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS",
        "android.permission.health.READ_BONE_MASS",
        "android.permission.health.READ_BODY_WATER_MASS",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_BASAL_METABOLIC_RATE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#047857",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 90
        }
      ],
      "expo-health-connect",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to estimate a meal from a picture.",
          "cameraPermission": "Allow camera access to photograph a meal for estimation."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a95ad262-dd24-4a89-afe3-c09385c81002"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a95ad262-dd24-4a89-afe3-c09385c81002"
    }
  }
}
